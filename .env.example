# Copy to .env and fill in. Never commit .env.

# --- PayPal (sandbox only) ---
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app
# Link the app to a US business sandbox account (an India one fails at approval with UNSUPPORTED_PAY...).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox = real PayPal sandbox (default). mock = fake Orders API + mock SDK/popup, no PayPal calls.
PAYPAL_MODE=sandbox
# Sandbox personal (buyer) account the shopper agent logs in with (Day 3, sandbox mode only).
# developer.paypal.com > Testing Tools > Sandbox Accounts. Never logged, stored or screenshotted.
# Must be the personal account, not the business one the app is linked to (PayPal: CANNOT_PAY_SELF).
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
# Vault payments (--payment vault) need the Vault / "save payment methods" feature enabled on the sandbox REST app
# (developer dashboard > Apps & Credentials > your app > Features). No extra variables: the token lives in SQLite.

# --- LLM (the shopper agent and fix rewording; the score never uses it) ---
# Providers: nvidia, groq, openai, openrouter, together, ollama (local, no key), anthropic,
# openai-compatible (any OpenAI-style server; also set LLM_BASE_URL).
LLM_PROVIDER=
# A tool-calling model id for that provider.
LLM_MODEL=
# Not needed for ollama.
LLM_API_KEY=
# Optional: override the provider's default base URL (required for openai-compatible).
LLM_BASE_URL=
# Optional: a vision model, so the shopper can look at the page like a vision-capable AI shopping agent
# (the "Shopper can see images" option, CLI --vision). Same provider, base URL and key as above. Never changes the score.
# For NVIDIA: nvidia/nemotron-3.5-super-vl-120b-a12b (listed at https://integrate.api.nvidia.com/v1/models)
VISION_MODEL=
# Primary setup, NVIDIA Nemotron (key from build.nvidia.com). LLM_PROVIDER=nvidia sets the base URL for you;
# openai-compatible with LLM_BASE_URL=https://integrate.api.nvidia.com/v1 works too:
#   LLM_PROVIDER=nvidia
#   LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5   (example id; pick a Nemotron model with tool calling from the catalog)
#   LLM_API_KEY=<your NVIDIA API key>

# --- Kernel (hosted browsers, real runs only) ---
KERNEL_API_KEY=
# local (default) or kernel. Kernel's browser runs in the cloud, so the store must be on a public URL.
BROWSER_PROVIDER=local

# --- Channel3 (market check) ---
CHANNEL3_API_KEY=

# --- App ---
# SQLite file, relative to the repo root.
DATABASE_PATH=data/ghostshopper.db
# Public base URL of this app (used for links the agent visits).
APP_BASE_URL=http://localhost:8000
# Optional: browser channel for Playwright, e.g. "chromium" (full build) or "msedge" (installed Edge).
PLAYWRIGHT_CHANNEL=

# --- Access and safety ---
# Developer options on POST /api/runs (llm, cassette, flaws, ...) and an open /store/admin page.
# Empty = on when APP_BASE_URL is localhost, off otherwise. Never set to 1 on a public server.
DEV_OPTIONS=
# Unlocks /store/admin (the flaw toggles) on a deployed server: open /store/admin and type this into the unlock form once.
# Leave empty to keep it locked. Real sandbox purchases don't need it; the daily caps below limit them.
DEMO_ADMIN_TOKEN=
# Checks older than this many days are deleted at startup (shared examples are kept).
RETENTION_DAYS=30
# 1 = load the bundled example checks (backend/app/examples/) at startup if they are missing. On for the hosted demo,
# whose disk starts empty after every restart. Make the bundle with: python -m backend.app.examples export <run ids>
EXAMPLE_RUNS=
# Proxies in front of the app that append to X-Forwarded-For. The client IP is that many entries from the right (Render: 1).
# 0 = ignore the header (direct connections only).
TRUSTED_PROXY_HOPS=1
# Process-wide caps per day on the calls that spend quota (runs, market check, PayPal orders). The presenter unlock skips them.
RUN_DAILY_CAP=40
MARKET_DAILY_CAP=100
ORDER_DAILY_CAP=100
