# Copy to .env and fill in. Never commit .env.

# --- PayPal (sandbox only) ---
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox = real PayPal sandbox (default). mock = fake Orders API + mock SDK/popup, no PayPal calls.
PAYPAL_MODE=sandbox
# Sandbox personal (buyer) account the shopper agent logs in with (Day 3, sandbox mode only).
# developer.paypal.com > Testing Tools > Sandbox Accounts. Never logged, stored or screenshotted.
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# --- Groq (LLM, free tier) ---
GROQ_API_KEY=
# Check console.groq.com/docs/models for a current tool-calling model (Day 2).
GROQ_MODEL=

# --- Kernel (hosted browsers, real runs only) ---
KERNEL_API_KEY=
# local (default) or kernel. Kernel's browser runs in the cloud, so the store must be on a public URL.
BROWSER_PROVIDER=local

# --- Channel3 (market check) ---
CHANNEL3_API_KEY=

# --- App ---
# SQLite file, relative to the repo root.
DATABASE_PATH=data/ghostshopper.db
# Public base URL of this app (used for links the agent visits).
APP_BASE_URL=http://localhost:8000
# Optional: browser channel for Playwright, e.g. "chromium" (full build) or "msedge" (installed Edge).
PLAYWRIGHT_CHANNEL=

# --- Access and safety ---
# Developer options on POST /api/runs (llm, cassette, flaws, ...) and an open /store/admin page.
# Empty = on when APP_BASE_URL is localhost, off otherwise. Never set to 1 on a public server.
DEV_OPTIONS=
# Unlocks /store/admin on a deployed server: open /store/admin?token=<this> once. Leave empty to keep it locked.
DEMO_ADMIN_TOKEN=
# Checks older than this many days are deleted at startup (shared examples are kept).
RETENTION_DAYS=30
