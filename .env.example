# Copy to .env and fill in. Never commit .env.

# --- PayPal (sandbox only) ---
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox personal (buyer) account, used by the shopper agent from Day 3.
# developer.paypal.com > Testing Tools > Sandbox Accounts
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# --- Groq (LLM, free tier) ---
GROQ_API_KEY=
# Check console.groq.com/docs/models for a current tool-calling model (Day 2).
GROQ_MODEL=

# --- Kernel (hosted browsers, real runs only) ---
KERNEL_API_KEY=

# --- Channel3 (market check) ---
CHANNEL3_API_KEY=

# --- App ---
# SQLite file, relative to the repo root.
DATABASE_PATH=data/ghostshopper.db
# Public base URL of this app (used for links the agent visits).
APP_BASE_URL=http://localhost:8000
